#!/bin/bash
#
# VX Toolchain - Go 版本构建脚本
#
# 构建所有 VX 工具链组件:
#   vxc    - VX 编译器前端
#   vlnk   - VX Linker 包装器
#   vdlnk  - VX De-Linker
#   vxde   - VX 反编译器
#   vxlsp  - VX 语言服务器
#   vpm    - VX 包管理器
#
# 用法: ./build.sh [选项] [命令]
#
# 命令:
#   all        构建所有组件 (默认)
#   <binary>   构建指定组件 (如 vxc, vlnk, ...)
#
# 选项:
#   -m, --mode <mode>   构建模式: debug | release (默认: release)
#   -o, --out <dir>     输出目录 (默认: 项目根目录)
#   -h, --help          显示此帮助信息
#
# 环境变量:
#   GOOS      目标操作系统 (默认: 当前系统)
#   GOARCH    目标架构 (默认: 当前架构)
#   CGO_ENABLED  是否启用 CGo (默认: 0)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"
MODULE_NAME="github.com/vx-lang/vxc"

# ─── 默认配置 ────────────────────────────────────────────────────────────────

MODE="release"
OUT_DIR="$PROJECT_ROOT/bin"
BUILD_WHAT=()

# 工具列表: name=main_path
TOOL_NAMES=(vxc vlnk vdlnk vxde vxlsp vpm vfmt)
TOOL_PATHS=(cmd/vxc/main.go cmd/vlnk/main.go cmd/vdlnk/main.go cmd/vxde/main.go cmd/vxlsp/main.go cmd/vpm/main.go cmd/vfmt/main.go)

# ─── 颜色输出 ────────────────────────────────────────────────────────────────

if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    CYAN='\033[0;36m'
    NC='\033[0m' # No Color
else
    RED=''; GREEN=''; YELLOW=''; CYAN=''; NC=''
fi

info()  { echo -e "${GREEN}[INFO]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# ─── 辅助函数 ────────────────────────────────────────────────────────────────

# 获取工具的主入口路径
get_tool_path() {
    local name="$1"
    for i in "${!TOOL_NAMES[@]}"; do
        if [ "${TOOL_NAMES[$i]}" = "$name" ]; then
            echo "${TOOL_PATHS[$i]}"
            return 0
        fi
    done
    return 1
}

# 判断名称是否为有效工具
is_valid_tool() {
    local name="$1"
    for t in "${TOOL_NAMES[@]}"; do
        if [ "$t" = "$name" ]; then
            return 0
        fi
    done
    return 1
}

# ─── 帮助信息 ────────────────────────────────────────────────────────────────

usage() {
    sed -n '2,24p' "$0" | sed 's/^# //; s/^#$//'
    echo ""
    echo "可用组件: ${TOOL_NAMES[*]}"
    echo ""
    echo "示例:"
    echo "  ./build.sh                    # release 模式构建全部"
    echo "  ./build.sh vxc vxlsp          # 仅构建 vxc 和 vxlsp"
    echo "  ./build.sh -m debug vxc       # debug 模式构建 vxc"
    echo "  ./build.sh -m release -o ./dist   # 输出到 ./dist 目录"
}

# ─── 解析参数 ────────────────────────────────────────────────────────────────

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -m|--mode)
            if [ $# -lt 2 ]; then
                error "--mode 需要参数 (debug|release)"
                exit 1
            fi
            MODE="$2"
            shift 2
            ;;
        -o|--out)
            if [ $# -lt 2 ]; then
                error "--out 需要参数 (目录路径)"
                exit 1
            fi
            OUT_DIR="$2"
            shift 2
            ;;
        -*)
            error "未知选项: $1"
            usage
            exit 1
            ;;
        *)
            BUILD_WHAT+=("$1")
            shift
            ;;
    esac
done

# 如果未指定组件，默认构建全部
if [ ${#BUILD_WHAT[@]} -eq 0 ]; then
    BUILD_WHAT=("${TOOL_NAMES[@]}")
fi

# ─── 验证配置 ────────────────────────────────────────────────────────────────

case "$MODE" in
    debug|release) ;;
    *)
        error "无效的构建模式: $MODE (可选: debug, release)"
        exit 1
        ;;
esac

for name in "${BUILD_WHAT[@]}"; do
    if ! is_valid_tool "$name"; then
        error "未知组件: $name"
        echo "可用组件: ${TOOL_NAMES[*]}"
        exit 1
    fi
done

# 确保 Go 已安装
if ! command -v go &>/dev/null; then
    error "未找到 Go 编译器，请先安装 Go 1.21+"
    exit 1
fi

# ─── 构建参数 ────────────────────────────────────────────────────────────────

GO_FLAGS=()

if [ "$MODE" = "release" ]; then
    GO_FLAGS+=(-ldflags "-s -w")
    echo -e "${YELLOW}▶ 构建模式: release (优化大小, 去除调试信息)${NC}"
else
    GO_FLAGS+=(-gcflags "-N -l")
    echo -e "${CYAN}▶ 构建模式: debug (保留调试信息)${NC}"
fi

GO_FLAGS+=(-trimpath)

# ─── 输出目录 ────────────────────────────────────────────────────────────────

mkdir -p "$OUT_DIR"

# ─── 构建 ────────────────────────────────────────────────────────────────────

BUILD_FAILED=0
BUILD_COUNT=0

for name in "${BUILD_WHAT[@]}"; do
    MAIN_PATH="$(get_tool_path "$name")"
    OUTPUT="$OUT_DIR/$name"

    echo ""
    info "构建 ${CYAN}$name${NC} ..."
    echo "  源文件: $MAIN_PATH"
    echo "  输出:   $OUTPUT"

    set +e
    go build \
        "${GO_FLAGS[@]}" \
        -o "$OUTPUT" \
        "./$MAIN_PATH"
    EXIT_CODE=$?
    set -e

    if [ $EXIT_CODE -eq 0 ]; then
        # 获取文件大小
        if [ -f "$OUTPUT" ]; then
            # macOS (stat -f%z) 和 Linux (stat -c%s) 兼容
            SIZE=""
            if stat -f%z "$OUTPUT" &>/dev/null; then
                SIZE="$(stat -f%z "$OUTPUT")"
            else
                SIZE="$(stat -c%s "$OUTPUT" 2>/dev/null || echo "")"
            fi
            SIZE_HUMAN=""
            if [ -n "$SIZE" ]; then
                if [ "$SIZE" -ge 1048576 ]; then
                    SIZE_HUMAN=" ($(echo "scale=1; $SIZE/1048576" | bc) MiB)"
                elif [ "$SIZE" -ge 1024 ]; then
                    SIZE_HUMAN=" ($(echo "scale=1; $SIZE/1024" | bc) KiB)"
                fi
            fi
            info "${GREEN}✓${NC} ${name} 构建成功${SIZE_HUMAN}"
        else
            info "${GREEN}✓${NC} ${name} 构建成功"
        fi
        BUILD_COUNT=$((BUILD_COUNT + 1))
    else
        error "${name} 构建失败 (退出码: $EXIT_CODE)"
        BUILD_FAILED=1
    fi
done

# ─── 构建摘要 ────────────────────────────────────────────────────────────────

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ $BUILD_FAILED -eq 0 ]; then
    info "${GREEN}全部构建成功${NC} ($BUILD_COUNT/${#BUILD_WHAT[@]})"
    if [ "$OUT_DIR" != "$PROJECT_ROOT" ]; then
        echo "  输出目录: $OUT_DIR"
    fi
else
    error "部分组件构建失败 ($BUILD_COUNT/${#BUILD_WHAT[@]} 成功)"
    exit 1
fi
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"