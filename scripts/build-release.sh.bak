#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# build-release.sh
# ─────────────────────────────────────────────────────────────────────
# 用 CMake + Ninja 交叉构建 VX-ToolKit 的多平台二进制 Zip 压缩包。
#
# 产出（默认输出到 ./dist/）：
#   dist/vx-toolkit-linux-x86_64.zip
#   dist/vx-toolkit-linux-aarch64.zip
#   dist/vx-toolkit-linux-riscv64.zip
#   dist/vx-toolkit-linux-armv7.zip
#   dist/vx-toolkit-freebsd-x86_64.zip
#   dist/vx-toolkit-freebsd-aarch64.zip
#   dist/vx-toolkit-macos-aarch64.zip
#   dist/vx-toolkit-macos-x86_64.zip
#
# 每个 Zip 包含：
#   - vxc002, vlnk, vmake, vxls, vx-tidy  （可执行文件）
#   - libvx_util.a, libvx_compiler.a, libvx_backend.a
#   - headers/   （@imp / @cppimp 导入库）
#   - std/       （VX 标准库源码）
#   - install.sh  （安装脚本）
#
# 用法：
#   ./scripts/build-release.sh
#   TARGETS="linux-x86_64 macos-aarch64" ./scripts/build-release.sh
#   OUT_DIR=/tmp/dist ./scripts/build-release.sh
# ─────────────────────────────────────────────────────────────────────
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPTS_DIR="$ROOT_DIR/scripts/toolchains"
OUT_DIR="${OUT_DIR:-$ROOT_DIR/dist}"
TARGETS="${TARGETS:-linux-x86_64 linux-aarch64 linux-riscv64 linux-armv7 freebsd-x86_64 freebsd-aarch64 macos-aarch64 macos-x86_64}"
BUILD_TYPE="${CMAKE_BUILD_TYPE:-MinSizeRel}"

# ── 前置检查 ────────────────────────────────────────────────────────
step() { printf "\n━━━ %s ━━━\n" "$*"; }
die()  { printf "❌ %s\n" "$*" >&2; exit 1; }

step "检查构建工具"
command -v cmake  >/dev/null || die "cmake 未找到"
command -v ninja >/dev/null || die "ninja 未找到"
command -v zip    >/dev/null || die "zip 未找到"
cmake --version | head -1
ninja --version

# ── 生成交叉编译器 wrapper（输出到 toolchain 同目录） ────────────────
step "生成交叉编译器 wrapper"
OUT_DIR="$SCRIPTS_DIR" "$SCRIPTS_DIR/make-cross-wrappers.sh"

# ── 逐目标构建 ─────────────────────────────────────────────────────
mkdir -p "$OUT_DIR"
cd "$ROOT_DIR"

for target in $TARGETS; do
  toolchain="$SCRIPTS_DIR/toolchain-${target}.cmake"
  [ -f "$toolchain" ] || die "toolchain 未找到: $toolchain"

  build_dir="$ROOT_DIR/build-$target"
  step "交叉构建: $target"
  cmake -S . -B "$build_dir" -G Ninja \
    -DCMAKE_BUILD_TYPE="$BUILD_TYPE" \
    -DCMAKE_TOOLCHAIN_FILE="$toolchain" 2>&1 | tail -3
  ninja -C "$build_dir" 2>&1 | tail -5

  # ── 打包 ─────────────────────────────────────────────────────────
  pkg_dir="$build_dir/_pkg"
  rm -rf "$pkg_dir"
  mkdir -p "$pkg_dir"

  # 可执行文件
  for bin in vxc002 vlnk; do
    [ -f "$build_dir/$bin" ] && cp "$build_dir/$bin" "$pkg_dir/"
  done
  # 工具
  for tool in vmake vxls vx-tidy; do
    [ -f "$build_dir/tools/$tool/$tool" ] && cp "$build_dir/tools/$tool/$tool" "$pkg_dir/"
  done
  # 静态库
  for lib in libvx_util.a libvx_compiler.a libvx_backend.a; do
    [ -f "$build_dir/$lib" ] && cp "$build_dir/$lib" "$pkg_dir/"
  done
  # vx-tidy 动态库
  [ -f "$build_dir/tools/vx-tidy/libvxtidy.dylib" ] && \
    cp "$build_dir/tools/vx-tidy/libvxtidy.dylib" "$pkg_dir/"

  # 资源目录
  cp -r "$ROOT_DIR/headers" "$pkg_dir/"
  cp -r "$ROOT_DIR/std"     "$pkg_dir/"

  # 安装脚本
  cp "$SCRIPTS_DIR/install.sh" "$pkg_dir/"

  zipname="vx-toolkit-${target}.zip"
  (cd "$pkg_dir" && zip -q -r "$OUT_DIR/$zipname" .)
  rm -rf "$pkg_dir"

  size=$(du -h "$OUT_DIR/$zipname" | cut -f1)
  printf "  ✅ %s (%s)\n" "$zipname" "$size"
done

# ── 汇总 ────────────────────────────────────────────────────────────
echo ""
echo "🎉 构建完成，产物位于: $OUT_DIR"
ls -lh "$OUT_DIR"/*.zip