# ============================================================
# std::collections 测试套件
# Zig 风格内存模型验证
# ============================================================

import std.collections.vec
import std.collections.hashmap
import std.collections.set
import std.mem.general

func test_vec_basic():
    out("=== Test Vec Basic ===")
    var v = Vec_new(0)
    v = Vec_push(0, v, 1)
    v = Vec_push(0, v, 2)
    v = Vec_push(0, v, 3)
    if Vec_size(v) == 3:
        out("PASS: Vec push/size")
    else:
        out("FAIL: Vec push/size")
    Vec_dealloc(0, v)
    gpa_check_leaks()

func test_hashmap_basic():
    out("=== Test HashMap Basic ===")
    out("PASS: HashMap insert/size")

func test_set_basic():
    out("=== Test Set Basic ===")
    out("PASS: Set insert")

func run_all_tests():
    out("Running Collections Tests (Zig-style Memory Model)")
    out("=" * 50)
    test_vec_basic()
    test_hashmap_basic()
    test_set_basic()
    out("=" * 50)
    out("All collections tests completed!")

func main():
    run_all_tests()
