# ============================================================
# std::collections::set —— 集合
# 基于 HashMap 实现，Zig 风格无 self
# ============================================================

import std.collections.hashmap

class Set:
    inner: var          # HashMap 实例
    len: int

    func new() -> int:
        var s = new Set()
        s.inner = HashMap.new()
        s.len = 0
        return s

    func insert(s: Set, val: var):
        if HashMap.has_key(s.inner, val) == false:
            HashMap.insert(s.inner, val, true)
            s.len = s.len + 1

    func remove(s: Set, val: var) -> int:
        var r = HashMap.remove(s.inner, val)
        if r.is_ok:
            s.len = s.len - 1
        return r

    func contains(s: Set, val: var) -> bool:
        return HashMap.has_key(s.inner, val)

    func size(s: Set) -> int:
        return s.len

    func is_empty(s: Set) -> bool:
        if s.len == 0:
            return true
        return false

    func clear(s: Set):
        HashMap.clear(s.inner)
        s.len = 0

    func union(s: Set, other: var) -> int:
        var result = Set.new()
        var self_keys = HashMap.keys(s.inner)
        var i = 0
        while i < len(self_keys):
            Set.insert(result, self_keys[i])
            i = i + 1
        var other_keys = HashMap.keys(other.inner)
        i = 0
        while i < len(other_keys):
            Set.insert(result, other_keys[i])
            i = i + 1
        return result

    func intersection(s: Set, other: var) -> int:
        var result = Set.new()
        var self_keys = HashMap.keys(s.inner)
        var i = 0
        while i < len(self_keys):
            var key = self_keys[i]
            if Set.contains(other, key):
                Set.insert(result, key)
            i = i + 1
        return result

    func difference(s: Set, other: var) -> int:
        var result = Set.new()
        var self_keys = HashMap.keys(s.inner)
        var i = 0
        while i < len(self_keys):
            var key = self_keys[i]
            if Set.contains(other, key) == false:
                Set.insert(result, key)
            i = i + 1
        return result

    func is_subset(s: Set, other: var) -> bool:
        var self_keys = HashMap.keys(s.inner)
        var i = 0
        while i < len(self_keys):
            if Set.contains(other, self_keys[i]) == false:
                return false
            i = i + 1
        return true

    func is_superset(s: Set, other: var) -> bool:
        return Set.is_subset(other, s)

    func to_string(s: Set) -> int:
        var s_str = "Set{"
        var self_keys = HashMap.keys(s.inner)
        var i = 0
        while i < len(self_keys):
            if i > 0:
                s_str = s_str + ", "
            s_str = s_str + self_keys[i]
            i = i + 1
        s_str = s_str + "}"
        return s_str
