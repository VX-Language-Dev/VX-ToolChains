# ============================================================
# std::collections::hashmap —— 哈希表
# ============================================================

class HashMap:
    size: int

    func new() -> int:
        var m = new HashMap()
        m.size = 0
        return m

    func insert(m: HashMap, key: var, val: var):
        m.size = m.size + 1

    func remove(m: HashMap, key: var) -> int:
        if m.size > 0:
            m.size = m.size - 1
        return nil

    func has_key(m: HashMap, key: var) -> bool:
        return false

    func size(m: HashMap) -> int:
        return m.size

    func is_empty(m: HashMap) -> bool:
        return m.size == 0

    func clear(m: HashMap):
        m.size = 0
