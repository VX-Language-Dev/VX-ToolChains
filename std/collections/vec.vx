# Vec: dynamic array for VX
# Uses raw malloc/free for heap allocation

struct Vec:
    data: int
    size: int
    capacity: int

extern malloc(size: int) -> int
extern free(ptr: int)

func vec_new() -> Vec:
    var v: Vec = new Vec()
    v.size = 0
    v.capacity = 0
    v.data = 0
    return v

func vec_push(v: Vec*, val: int):
    if v.size >= v.capacity:
        var new_cap: int = 4
        if v.capacity != 0:
            new_cap = v.capacity * 2
        var new_data = malloc(new_cap * 8)
        v.data = new_data
        v.capacity = new_cap
    v.data[v.size] = val
    v.size = v.size + 1

func vec_get(v: Vec*, index: int) -> int:
    return v.data[index]

func vec_size(v: Vec*) -> int:
    return v.size

func vec_capacity(v: Vec*) -> int:
    return v.capacity

func vec_set(v: Vec*, index: int, val: int):
    v.data[index] = val
