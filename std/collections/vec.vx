# ============================================================
# std::collections::vec —— 动态数组 Vec
# Zig 风格：显式分配器传参
# ============================================================

import std.mem.allocator

# Vec 内存布局（每个槽位 8 字节，64 位平台）:
#   buf[0] = capacity (int)
#   buf[1] = size (int)
#   buf[2..] = 元素数组

func Vec_new(alloc: var) -> int:
    var buf = malloc(2048)
    buf[0] = 254
    buf[1] = 0
    return buf

func Vec_push(alloc: var, v: int, val: int) -> int:
    var size = v[1]
    var cap = v[0]
    if size >= cap:
        return v
    v[size + 2] = val
    v[1] = size + 1
    return v

func Vec_get(v: int, index: int) -> int:
    if index < 0 or index >= v[1]:
        return 0
    return v[index + 2]

func Vec_size(v: int) -> int:
    return v[1]

func Vec_is_empty(v: int) -> bool:
    return v[1] == 0

func Vec_dealloc(alloc: var, v: int):
    c_free(v)
